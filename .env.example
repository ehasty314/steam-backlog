# Copy this file to .env.local and fill in your key.
# Get a key at https://steamcommunity.com/dev/apikey (never commit .env.local).
STEAM_API_KEY=

# Optional: time-to-beat estimates from IGDB. Create a free app at
# https://dev.twitch.tv/console/apps (OAuth redirect URL: http://localhost), then copy
# its Client ID and generate a Client Secret.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
